### 404 — unknown booking
DELETE {{baseUrl}}/bookings/{{missingId}}


### 201 — independent film for deletion
# @name disposableFilm
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Interstellar",
  "durationMinutes": 169,
  "releaseYear": 2014
}

### 204 — delete independent film
DELETE {{baseUrl}}/films/{{disposableFilm.response.body.$.id}}


### 201 — independent hall for deletion
# @name disposableHall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Disposable",
  "rows": 3,
  "seatsPerRow": 5
}

### 204 — delete independent hall
DELETE {{baseUrl}}/halls/{{disposableHall.response.body.$.id}}


### 200 — second page in descending order
GET {{baseUrl}}/showings?filmId={{filmId}}&page=2&limit=1&sort=desc

### 400 — page below minimum
GET {{baseUrl}}/showings?page=0

### 400 — fractional page
GET {{baseUrl}}/showings?page=1.5

### 400 — limit above maximum
GET {{baseUrl}}/showings?limit=101

### 400 — fractional limit
GET {{baseUrl}}/showings?limit=2.5

### 400 — invalid sort
GET {{baseUrl}}/showings?sort=newest

### 400 — malformed film UUID
GET {{baseUrl}}/showings?filmId=invalid
