  "seats": [
    {
      "row": 1,
      "seat": 3
    },
    {
      "row": 1,
      "seat": 1
    }
  ]
}

### 200 — check 1:3 remains free
GET {{baseUrl}}/showings/{{showingId}}/seats


### 204 — cancel booking
DELETE {{baseUrl}}/bookings/{{bookingId}}


### 200 — seats released
GET {{baseUrl}}/showings/{{showingId}}/seats


### 404 — cancelled booking
