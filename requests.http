@baseUrl = http://localhost:3000
@missingId = 00000000-0000-4000-8000-000000000000
@filmId = {{film.response.body.$.id}}
@hallId = {{hall.response.body.$.id}}
@showingId = {{showing.response.body.$.id}}
@bookingId = {{booking.response.body.$.id}}

# VS Code REST Client: run each request from top to bottom on a fresh server.

### 201 — create film
# @name film
POST {{baseUrl}}/films
Content-Type: application/json

{
  "title": "Interstellar",
  "durationMinutes": 169,
  "releaseYear": 2014
}

### 200 — films
GET {{baseUrl}}/films


### 200 — film
GET {{baseUrl}}/films/{{filmId}}


### 200 — update
PATCH {{baseUrl}}/films/{{filmId}}
Content-Type: application/json

{
  "title": "Interstellar updated"
}

### 201 — create hall
# @name hall
POST {{baseUrl}}/halls
Content-Type: application/json

{
  "name": "Main",
  "rows": 3,
  "seatsPerRow": 5
}

### 200 — halls
GET {{baseUrl}}/halls


### 200 — hall, 15 seats
GET {{baseUrl}}/halls/{{hallId}}


### 201 — create showing
# @name showing
POST {{baseUrl}}/showings
Content-Type: application/json

{
  "filmId": "{{filmId}}",
  "hallId": "{{hallId}}",
  "startsAt": "2099-06-15T12:00:00Z",
  "price": 12500
}

### 200 — schedule
GET {{baseUrl}}/showings


### 200 — schedule
GET {{baseUrl}}/showings?filmId={{filmId}}


### 200 — schedule
GET {{baseUrl}}/showings?date=2099-06-15


### 200 — schedule
GET {{baseUrl}}/showings?filmId={{filmId}}&date=2099-06-15


### 200 — showing
GET {{baseUrl}}/showings/{{showingId}}


### 200 — available seats
GET {{baseUrl}}/showings/{{showingId}}/seats


### 200 — empty bookings
GET {{baseUrl}}/bookings


### 201 — booking, total 25000
# @name booking
POST {{baseUrl}}/showings/{{showingId}}/bookings
Content-Type: application/json

{
  "seats": [
    {
      "row": 1,
      "seat": 1
    },
    {
      "row": 1,
      "seat": 2
    }
  ]
}

### 200 — all bookings
GET {{baseUrl}}/bookings


### 200 — showing bookings
GET {{baseUrl}}/showings/{{showingId}}/bookings


### 200 — occupied seats
GET {{baseUrl}}/showings/{{showingId}}/seats


